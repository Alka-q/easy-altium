<Window x:Class="EasyAltium.Host.Views.MiniSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyAltium — LCSC &amp; JLCPCB Loader"
        Width="440"
        Height="530"
        MinWidth="410"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding AlwaysOnTop}"
        Background="#14171D"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Üst Başlık ve Hızlı Kontroller -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="HeaderBrandIcon"
                           Width="18"
                           Height="18"
                           Margin="0,0,7,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="EASYALTIUM"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="#F59E0B"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <Border Background="#262B36"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding AltiumVersionBadgeText}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#9CA3AF" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding LibraryModeBadgeText}"
                           FontSize="11"
                           Foreground="#9CA3AF"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Üstte Tut"
                          IsChecked="{Binding AlwaysOnTop}"
                          Foreground="#D1D5DB"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0" />
                <Button Content="Ayarlar"
                        Command="{Binding OpenSettingsCommand}"
                        Background="#262B36"
                        Foreground="#E5E7EB"
                        BorderBrush="#374151"
                        Padding="10,4"
                        Cursor="Hand" />
            </StackPanel>
        </Grid>

        <!-- Arama Çubuğu ve Pano Dinleyici -->
        <Border Grid.Row="1"
                Background="#1E222B"
                BorderBrush="#2E3440"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchLcscId, UpdateSourceTrigger=PropertyChanged}"
                             Background="#111318"
                             Foreground="#F9FAFB"
                             CaretBrush="#F59E0B"
                             BorderBrush="#374151"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Padding="8,6"
                             VerticalContentAlignment="Center"
                             KeyDown="SearchBox_OnKeyDown" />

                    <Button Grid.Column="1"
                            Content="LCSC Sorgula"
                            Command="{Binding FetchPartCommand}"
                            Background="#F59E0B"
                            Foreground="#111318"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Padding="14,6"
                            Margin="8,0,0,0"
                            Cursor="Hand" />
                </Grid>

                <WrapPanel Margin="0,8,0,0">
                    <CheckBox Content="Pano Dinleyici (^C[1-9]\d{2,}$) Aktif"
                              IsChecked="{Binding IsClipboardListening}"
                              Foreground="#D1D5DB"
                              Margin="0,0,14,4" />
                    <CheckBox Content="Mod B: SQLite .DbLib"
                              IsChecked="{Binding IsSqliteMode}"
                              Foreground="#D1D5DB"
                              Margin="0,0,14,4" />
                    <CheckBox Content="Pasiflerde Standart Sembol (R/C/L)"
                              IsChecked="{Binding UsePassiveTemplateSymbol}"
                              Foreground="#D1D5DB"
                              Margin="0,0,0,4" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Parça Meta Veri Önizleme Kartı -->
        <Border Grid.Row="2"
                Background="#1E222B"
                BorderBrush="#2E3440"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PartMpnDisplay}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#F9FAFB"
                                   Margin="0,0,8,0" />
                        <Border Background="#2D3748"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding PartClassDisplay}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#38BDF8" />
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Datasheet"
                            Command="{Binding OpenDatasheetCommand}"
                            Background="Transparent"
                            Foreground="#60A5FA"
                            BorderBrush="#2563EB"
                            BorderThickness="1"
                            Padding="8,2"
                            FontSize="11"
                            Cursor="Hand" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11.5" Foreground="#9CA3AF" Margin="0,2">
                        <Run Text="Üretici: " Foreground="#6B7280" />
                        <Run Text="{Binding PartManufacturerDisplay, Mode=OneWay}" Foreground="#E5E7EB" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11.5" Foreground="#9CA3AF" Margin="0,2">
                        <Run Text="Kılıf: " Foreground="#6B7280" />
                        <Run Text="{Binding PartPackageDisplay, Mode=OneWay}" Foreground="#E5E7EB" FontWeight="SemiBold" />
                    </TextBlock>

                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="11.5" Foreground="#9CA3AF" Margin="0,2">
                        <Run Text="Stok: " Foreground="#6B7280" />
                        <Run Text="{Binding PartStockDisplay, Mode=OneWay}" Foreground="#10B981" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11.5" Foreground="#9CA3AF" Margin="0,2">
                        <Run Text="Fiyat: " Foreground="#6B7280" />
                        <Run Text="{Binding PartPriceDisplay, Mode=OneWay}" Foreground="#FBBF24" FontWeight="Bold" />
                    </TextBlock>

                    <TextBlock Grid.Row="2" Grid.Column="0" FontSize="11.5" Foreground="#9CA3AF" Margin="0,2">
                        <Run Text="Kategori: " Foreground="#6B7280" />
                        <Run Text="{Binding PartCategoryDisplay, Mode=OneWay}" Foreground="#D1D5DB" />
                    </TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11.5" Foreground="#9CA3AF" Margin="0,2" TextTrimming="CharacterEllipsis">
                        <Run Text="Footprint: " Foreground="#6B7280" />
                        <Run Text="{Binding PartFootprintDisplay, Mode=OneWay}" Foreground="#D1D5DB" />
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="{Binding PartDescriptionDisplay}"
                           FontSize="11"
                           Foreground="#9CA3AF"
                           TextWrapping="Wrap"
                           MaxHeight="34"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- Altium Aktarım Aksiyon Butonları -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Altium'a Aktar &amp; Yerleştir"
                    Command="{Binding PlaceInAltiumCommand}"
                    Background="#10B981"
                    Foreground="#06281E"
                    FontWeight="Bold"
                    FontSize="13"
                    BorderThickness="0"
                    Padding="12,9"
                    Margin="0,0,6,0"
                    Cursor="Hand" />

            <Button Grid.Column="1"
                    Content="Sadece Kütüphaneye Yükle"
                    Command="{Binding LoadLibraryOnlyCommand}"
                    Background="#262B36"
                    Foreground="#F3F4F6"
                    BorderBrush="#374151"
                    FontSize="12"
                    Padding="10,9"
                    Cursor="Hand" />
        </Grid>

        <!-- Canlı İşlem Günlüğü -->
        <Border Grid.Row="4"
                Background="#111318"
                BorderBrush="#262B36"
                BorderThickness="1"
                CornerRadius="6"
                Padding="6">
            <ListBox ItemsSource="{Binding ActivityLogs}"
                     Background="Transparent"
                     Foreground="#9CA3AF"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="11" />
        </Border>

        <!-- Alt Durum Çubuğu -->
        <TextBlock Grid.Row="5"
                   Text="{Binding StatusMessage}"
                   FontSize="11"
                   Foreground="#9CA3AF"
                   Margin="0,8,0,0"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
