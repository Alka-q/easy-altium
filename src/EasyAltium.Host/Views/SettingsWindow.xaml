<Window x:Class="EasyAltium.Host.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyAltium — Configuration &amp; Settings"
        Width="560"
        Height="490"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#14171D"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="EasyAltium System &amp; Altium Designer Bridge Settings"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="#F59E0B"
                   Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Altium Designer Executable Path (X2.EXE — Version-Agnostic):"
                           FontSize="12"
                           Foreground="#D1D5DB"
                           Margin="0,4,0,4" />
                <TextBox x:Name="AltiumExeBox"
                         Background="#1E222B"
                         Foreground="#F9FAFB"
                         BorderBrush="#374151"
                         Padding="8,5" />

                <TextBlock Text="DelphiScript Bridge Project (LCSC_Bridge.PrjScr):"
                           FontSize="12"
                           Foreground="#D1D5DB"
                           Margin="0,10,0,4" />
                <TextBox x:Name="BridgePrjBox"
                         Background="#1E222B"
                         Foreground="#F9FAFB"
                         BorderBrush="#374151"
                         Padding="8,5" />

                <TextBlock Text="Rust npnp CLI Executable Path / Command:"
                           FontSize="12"
                           Foreground="#D1D5DB"
                           Margin="0,10,0,4" />
                <TextBox x:Name="NpnpExeBox"
                         Background="#1E222B"
                         Foreground="#F9FAFB"
                         BorderBrush="#374151"
                         Padding="8,5" />

                <TextBlock Text="npnp CLI Arguments Template ({LCSC_ID}, {OUTPUT_DIR}):"
                           FontSize="12"
                           Foreground="#D1D5DB"
                           Margin="0,10,0,4" />
                <TextBox x:Name="NpnpArgsBox"
                         Background="#1E222B"
                         Foreground="#F9FAFB"
                         BorderBrush="#374151"
                         Padding="8,5" />

                <TextBlock Text="Local Library Root Directory (./Library):"
                           FontSize="12"
                           Foreground="#D1D5DB"
                           Margin="0,10,0,4" />
                <TextBox x:Name="LibraryRootBox"
                         Background="#1E222B"
                         Foreground="#F9FAFB"
                         BorderBrush="#374151"
                         Padding="8,5" />

                <TextBlock Text="Passive Component Standard Symbol Template (.SchLib):"
                           FontSize="12"
                           Foreground="#D1D5DB"
                           Margin="0,10,0,4" />
                <TextBox x:Name="PassiveTemplateBox"
                         Background="#1E222B"
                         Foreground="#F9FAFB"
                         BorderBrush="#374151"
                         Padding="8,5" />

                <StackPanel Margin="0,12,0,0">
                    <CheckBox x:Name="InteractivePlacementCheck"
                              Content="Attach component to mouse cursor on schematic (InteractiveCursor)"
                              Foreground="#D1D5DB"
                              Margin="0,4" />
                    <CheckBox x:Name="OpenLibIfNoSchCheck"
                              Content="Open .SchLib in Altium if no active schematic (.SchDoc) is open"
                              Foreground="#D1D5DB"
                              Margin="0,4" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Install / Update Altium Toolbar Icon"
                    Click="InstallToolbarButton_OnClick"
                    Background="#2563EB"
                    Foreground="#F9FAFB"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Padding="12,6"
                    Cursor="Hand" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Click="CancelButton_OnClick"
                        Background="#262B36"
                        Foreground="#E5E7EB"
                        BorderBrush="#374151"
                        Padding="16,6"
                        Margin="0,0,8,0"
                        Cursor="Hand" />
                <Button Content="Save"
                        Click="SaveButton_OnClick"
                        Background="#F59E0B"
                        Foreground="#111318"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Padding="18,6"
                        Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
