<Window x:Class="EasyAltium.Host.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyAltium — Yapılandırma ve Ayarlar"
        Width="560"
        Height="490"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#14171D"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="EasyAltium Sistem &amp; Altium 26.10.1 Köprü Ayarları"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="#F59E0B"
                   Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Altium Designer 26.10.1 Yürütülebilir Dosya Yolu (X2.EXE):"
                           FontSize="12"
                           Foreground="#D1D5DB"
                           Margin="0,4,0,4" />
                <TextBox x:Name="AltiumExeBox"
                         Background="#1E222B"
                         Foreground="#F9FAFB"
                         BorderBrush="#374151"
                         Padding="8,5" />

                <TextBlock Text="DelphiScript Köprü Projesi (LCSC_Bridge.PrjScr):"
                           FontSize="12"
                           Foreground="#D1D5DB"
                           Margin="0,10,0,4" />
                <TextBox x:Name="BridgePrjBox"
                         Background="#1E222B"
                         Foreground="#F9FAFB"
                         BorderBrush="#374151"
                         Padding="8,5" />

                <TextBlock Text="Rust npnp CLI Yürütülebilir Dosya Yolu / Komutu:"
                           FontSize="12"
                           Foreground="#D1D5DB"
                           Margin="0,10,0,4" />
                <TextBox x:Name="NpnpExeBox"
                         Background="#1E222B"
                         Foreground="#F9FAFB"
                         BorderBrush="#374151"
                         Padding="8,5" />

                <TextBlock Text="npnp CLI Argüman Şablonu ({LCSC_ID}, {OUTPUT_DIR}):"
                           FontSize="12"
                           Foreground="#D1D5DB"
                           Margin="0,10,0,4" />
                <TextBox x:Name="NpnpArgsBox"
                         Background="#1E222B"
                         Foreground="#F9FAFB"
                         BorderBrush="#374151"
                         Padding="8,5" />

                <TextBlock Text="Yerel Kütüphane Kök Dizini (./Library):"
                           FontSize="12"
                           Foreground="#D1D5DB"
                           Margin="0,10,0,4" />
                <TextBox x:Name="LibraryRootBox"
                         Background="#1E222B"
                         Foreground="#F9FAFB"
                         BorderBrush="#374151"
                         Padding="8,5" />

                <TextBlock Text="Pasif Eleman Standart Sembol Şablonu (.SchLib):"
                           FontSize="12"
                           Foreground="#D1D5DB"
                           Margin="0,10,0,4" />
                <TextBox x:Name="PassiveTemplateBox"
                         Background="#1E222B"
                         Foreground="#F9FAFB"
                         BorderBrush="#374151"
                         Padding="8,5" />

                <StackPanel Margin="0,12,0,0">
                    <CheckBox x:Name="InteractivePlacementCheck"
                              Content="Şematikte fare imlecine bağlayarak yerleştir (InteractiveCursor)"
                              Foreground="#D1D5DB"
                              Margin="0,4" />
                    <CheckBox x:Name="OpenLibIfNoSchCheck"
                              Content="Aktif şematik (.SchDoc) açık değilse .SchLib dosyasını Altium'da aç"
                              Foreground="#D1D5DB"
                              Margin="0,4" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="İptal"
                    Click="CancelButton_OnClick"
                    Background="#262B36"
                    Foreground="#E5E7EB"
                    BorderBrush="#374151"
                    Padding="16,6"
                    Margin="0,0,8,0"
                    Cursor="Hand" />
            <Button Content="Kaydet"
                    Click="SaveButton_OnClick"
                    Background="#F59E0B"
                    Foreground="#111318"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Padding="18,6"
                    Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
