<Window x:Class="EasyAltium.Host.Views.PartPreviewPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyAltium — LCSC Parça Yakalandı"
        Width="370"
        Height="210"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Border Background="#181B22"
            BorderBrush="#F59E0B"
            BorderThickness="1.5"
            CornerRadius="8"
            Margin="6"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PANO YAKALANDI:"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#F59E0B"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock x:Name="LcscCodeText"
                               Text="C2040"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#F9FAFB"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#262B36"
                        CornerRadius="4"
                        Padding="6,2">
                    <TextBlock x:Name="JlcpcbClassBadge"
                               Text="Basic"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="#38BDF8" />
                </Border>
            </Grid>

            <!-- Meta Veri Özeti -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="MpnAndBrandText"
                           Text="RP2040 — Raspberry Pi"
                           FontSize="13.5"
                           FontWeight="Bold"
                           Foreground="#F3F4F6"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PackageAndStockText"
                           Text="Kılıf: QFN-56 | Stok: 48,520 | Fiyat: $0.8024"
                           FontSize="11.5"
                           Foreground="#10B981"
                           Margin="0,4,0,0" />
                <TextBlock x:Name="DescriptionText"
                           Text="Dual-Core ARM Cortex-M0+ Microcontroller"
                           FontSize="11"
                           Foreground="#9CA3AF"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Butonlar -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Altium'a Yerleştir"
                        Click="PlaceButton_OnClick"
                        Background="#10B981"
                        Foreground="#06281E"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Padding="10,6"
                        Margin="0,0,6,0"
                        Cursor="Hand" />

                <Button Grid.Column="1"
                        Content="Kütüphaneye Ekle"
                        Click="LoadOnlyButton_OnClick"
                        Background="#262B36"
                        Foreground="#E5E7EB"
                        BorderBrush="#374151"
                        Padding="10,6"
                        Margin="0,0,6,0"
                        Cursor="Hand" />

                <Button Grid.Column="2"
                        Content="Kapat"
                        Click="DismissButton_OnClick"
                        Background="Transparent"
                        Foreground="#9CA3AF"
                        BorderBrush="#374151"
                        Padding="8,6"
                        Cursor="Hand" />
            </Grid>
        </Grid>
    </Border>
</Window>
