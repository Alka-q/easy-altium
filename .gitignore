# ============================================================================
# EasyAltium (.NET 8 WPF + Altium Designer + SQLite) .gitignore
# ============================================================================

# .NET / Visual Studio Build Outputs
bin/
obj/
out/
publish/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# Altium Designer Temporary & History Files
History/
__Previews/
*.PrjScrStructure
*.htm
*.LOG
*~
*.bak

# Local Runtime IPC & Configuration Files (Examples are tracked instead)
ipc/appsettings.json
ipc/current_part.ini
ipc/current_part.tmp.ini
ipc/*.log
ipc/*.tmp

# Generated Component Libraries & SQLite Databases (Folder structure kept via .gitkeep)
Library/.staging/
Library/*.json
Library/SchLib/*.SchLib
!altium-bridge/Templates/*.SchLib
Library/PcbLib/*.PcbLib
Library/STEP/*.step
Library/STEP/*.stp
Library/DbLib/*.DbLib
Library/DbLib/*.sqlite
Library/DbLib/*.sqlite-shm
Library/DbLib/*.sqlite-wal
Library/DbLib/*.db
Library/Fallback/*
!Library/**/.gitkeep

# External CLI Binaries (License file and .gitkeep are tracked)
tools/npnp/*.exe
tools/npnp/*.zip
!tools/npnp/.gitkeep
!tools/npnp/LICENSE_npnp.txt

# Internal / Scratch Files
gemini-code-*.md

# OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
